# Backend API. Requerido para /api/analyze, /api/analyze-text y /api/embed.
# Ambientes (por ahora ambos apuntan al mismo backend):
#   dev (default): https://expense-audio-analyzer.ai.studio
#   qa           : https://expense-audio-analyzer.ai.studio
# Selección (prioridad):
#   1. EXPO_PUBLIC_API_URL (URL completa) — máxima prioridad.
#   2. EXPO_PUBLIC_ENV=dev|qa
# Uso local:
#   .env      → dev  (ignorado por git, este archivo es la plantilla)
#   .env.qa   → qa   (ignorado por git, copiar de esta plantilla)
#   .env.local → overrides personales (no commitear)
# Google OAuth: crear 3 client IDs en Google Cloud Console (iOS, Android, Web)
# y copiarlos a .env / .env.qa (nunca a este archivo).
# Scripts: `npm run ios` (dev), `npm run ios:qa` (qa).
EXPO_PUBLIC_ENV=dev
EXPO_PUBLIC_API_URL=https://expense-audio-analyzer.ai.studio
# Backend de billing/sync (mismo host que la API). Tiene /api/billing/refresh, /api/billing/webhook y /api/sync/*.
# Si no se define, el código usa el default (mismo que EXPO_PUBLIC_API_URL).
EXPO_PUBLIC_BILLING_URL=https://expense-audio-analyzer.ai.studio
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
